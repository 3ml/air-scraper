# Server
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Encryption (AES-256-GCM) - Must be 32 bytes (64 hex chars) or will be hashed
ENCRYPTION_SECRET=your-32-byte-secret-key-here-change-in-production

# Authentication
AUTH_TOKEN=dev-token-change-in-production
SCRAPER_SECRET=scraper-secret-for-callbacks

# Scoped tokens (optional): JSON array of tokens limited to specific scenarios.
# Each token needs: token (min 16 chars), name (unique, 'master' is reserved), scenarios (array).
# "screenshot" is a pseudo-scope for POST /api/screenshot.
# SCOPED_TOKENS=[{"token":"tok_change_me_min_16_chars","name":"backend-vikey","scenarios":["vikey","screenshot"]}]

# Database
DATABASE_PATH=./data/scraper.db

# Callback endpoints
CALLBACK_URL=https://app.airelite.it/api/scraper/callback
ALERT_WEBHOOK_URL=https://app.airelite.it/api/scraper/alert

# Proxy configuration
PROXY_ENABLED=false
PROXY_POOL_CONFIG=./data/proxies.json

# Browser settings
BROWSER_HEADLESS=true
BROWSER_POOL_SIZE=3
CONTEXT_STORAGE_PATH=./data/contexts

# Performance
MAX_CONCURRENT_TASKS=5
TASK_TIMEOUT_MS=300000

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log

# Telegram alerts (optional): used by sendTelegramMessage() to post alerts to a group.
# When unset, sendTelegramMessage() logs a warning and does nothing.
# TELEGRAM_ALERTS_CHAT_MESSAGE_THREAD_ID is the topic/thread id inside the group (omit for non-topic chats).
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
# TELEGRAM_ALERTS_CHAT_ID=-1001234567890
# TELEGRAM_ALERTS_CHAT_MESSAGE_THREAD_ID=42
